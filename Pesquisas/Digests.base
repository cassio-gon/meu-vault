filters:
  and:
    - file.hasTag("digest")
properties:
  area:
    displayName: Área
  date:
    displayName: Data/hora
  file.name:
    displayName: Digest
  file.folder:
    displayName: Pasta
views:
  - type: cards
    name: Recentes
    order:
      - area
      - date
    sort:
      - property: file.name
        direction: DESC
    limit: 24
  - type: table
    name: Por área
    groupBy:
      property: area
      direction: ASC
    order:
      - date
      - file.name
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: Linha do tempo
    order:
      - date
      - area
      - file.folder
    sort:
      - property: file.name
        direction: DESC
    limit: 60
